# Frontend environment variables.
#
# Copy this file to `.env.local` for local development. On Vercel, set the same
# variables in the project's Environment Variables (Project → Settings) instead
# of committing a file.

# Optional: URL of the FastAPI backend. Leave BLANK to run the app fully
# client-side (every engine runs in the browser — no backend required).
# On Vercel, set this to your Render backend URL (no trailing slash), e.g.
#   NEXT_PUBLIC_API_URL=https://thermal-shelter-api.onrender.com
NEXT_PUBLIC_API_URL=

# Optional: Open-Meteo API key. The free tier needs no key and already covers
# every location on Earth; a key only lifts the per-IP rate limit so many sites
# can be resolved in one session without 429s. Get one free at open-meteo.com.
NEXT_PUBLIC_OPEN_METEO_API_KEY=

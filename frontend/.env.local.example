# Copy this file to `.env.local` and fill in what you need.
# `.env.local` is git-ignored, so it is safe to keep secrets here.

# --- Optional: FastAPI backend URL -------------------------------------------
# When set, the header shows a "Backend" toggle that routes climate resolution
# and surrogate screening through the Python service. Leave unset for the app to
# run entirely in the browser (no server needed).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Optional: Open-Meteo API key --------------------------------------------
# The free tier needs NO key and already covers EVERY location on Earth — any
# latitude/longitude. A key ONLY lifts the per-IP rate limit, so resolving many
# sites in one session (or behind a shared IP) does not get 429s. Get one at
# https://open-meteo.com/en/docs (customer area). You can also paste it into the
# topbar at runtime, which overrides this value.
# NEXT_PUBLIC_OPEN_METEO_API_KEY=

# Render environment template — SIH Thermal Shelter API
#
# THIS IS A TEMPLATE, NOT A LIVE CONFIG FILE. Do not rename it to `.env`.
#
# Two ways to use it:
#
#   1. Blueprint (recommended). `render.yaml` at the repo root already declares
#      every variable below. Click New -> Blueprint in Render and it is applied
#      for you. You only have to edit the CORS_ORIGINS placeholder.
#
#   2. Manual service. Create the web service by hand and paste these pairs into
#      Dashboard -> your service -> Environment -> "Add from .env".
#
# Every key here is read by `app/config.py`. That file defines exactly twelve
# settings; anything not in the list below is ignored (`extra="ignore"`), so
# adding keys here does nothing but mislead the next reader.

# --- Service ---------------------------------------------------------------
# The settings are `app_name` / `version` / `debug` in config.py. Note VERSION,
# not APP_VERSION — the latter silently does nothing.
APP_NAME=SIH Thermal Shelter API
VERSION=1.0.0
DEBUG=false

# --- Persistence -----------------------------------------------------------
# DO NOT set DATABASE_URL by hand when using the Blueprint: `render.yaml`
# injects it from the managed database via `fromDatabase`. Setting it here would
# override the injected value and point the service at a SQLite file that does
# not survive a deploy.
#
# For a manual service, copy the "Internal Database URL" from the Render
# database page. The scheme must be postgresql+psycopg:// so SQLAlchemy picks
# the psycopg 3 driver that requirements.txt installs.
#
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
SQL_ECHO=false

# --- CORS ------------------------------------------------------------------
# COMMA-SEPARATED. This is the single most common deployment mistake.
#
# `config.py` parses this by splitting on commas (`cors_origin_list`). A JSON
# array — ["https://a.vercel.app","http://localhost:3000"] — is NOT parsed; it
# produces one malformed origin and every browser request from the frontend
# fails the CORS preflight.
#
# Replace the placeholder with your real frontend URL. List the production
# domain and any preview domains you actually use. No trailing slash.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# --- Climate provider ------------------------------------------------------
# The offline catalogue answers every request on its own. The live Open-Meteo
# archive is an upgrade over it, not a prerequisite.
OPEN_METEO_BASE=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT_S=20.0
# Four seconds is long enough for a slow link and short enough that a dead one
# costs a visible pause rather than a stall. When it times out the provider
# chain falls through to the offline database and records the failure.
LIVE_PROBE_TIMEOUT_S=4.0
ENABLE_LIVE_CLIMATE=true

# --- ML surrogate ----------------------------------------------------------
# Leave MODEL_DIR as ./models. `backend/models/` is git-ignored, so a deployed
# service starts with no trained model — that is expected, and it is why
# /api/optimize returns 503 until you train one.
MODEL_DIR=./models
# Minimum rows before training will start. The *accuracy* gate is deliberately
# not configurable: it lives beside FEATURE_NAMES in app/ml.py so a deployer
# cannot relax it into usefulness.
MIN_TRAIN_ROWS=200

# --- Platform (read by Render, not by the app) -----------------------------
PYTHON_VERSION=3.11

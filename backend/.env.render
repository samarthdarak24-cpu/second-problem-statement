# Production Environment Variables for Render.com
# Copy these to Render Dashboard → Environment Variables

# Application Settings
APP_NAME=SIH Thermal Shelter Design System
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# Server Configuration (Render sets PORT automatically)
HOST=0.0.0.0

# CORS - UPDATE WITH YOUR FRONTEND URLS!
CORS_ORIGINS=["https://your-frontend-app.vercel.app","https://your-frontend-app.onrender.com","http://localhost:3000"]

# Database - Render provides this automatically if using managed PostgreSQL
# Leave as ${DATABASE_URL} - Render will inject the value
DATABASE_URL=${DATABASE_URL}

# External APIs (No keys needed - Open-Meteo is free)
OPENMETEO_API_URL=https://api.open-meteo.com/v1
OPEN_METEO_BASE=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT_S=20.0
LIVE_PROBE_TIMEOUT_S=4.0
ENABLE_LIVE_CLIMATE=true

# Machine Learning
USE_ML_OPTIMIZATION=False
ML_MODEL_PATH=./models
MODEL_DIR=./models
MIN_TRAIN_ROWS=200

# Security - Click "Generate" in Render for SECRET_KEY
SECRET_KEY=${SECRET_KEY}
API_KEY_REQUIRED=False

# Feature Flags
ENABLE_ML_FEATURES=True
ENABLE_ADVANCED_THERMAL_MODEL=True
ENABLE_COST_OPTIMIZATION=True
ENABLE_ENERGY_SIMULATION=True
ENABLE_SOLAR_ANALYSIS=True

# Performance
MAX_CONCURRENT_OPTIMIZATIONS=5
REQUEST_TIMEOUT_SECONDS=300
ENABLE_ASYNC_PROCESSING=True

# Logging
LOG_LEVEL=INFO
SQL_ECHO=False

# Cache
ENABLE_CACHE=True
CACHE_TTL=3600

# Climate Data
CLIMATE_DATA_CACHE_DAYS=30
CLIMATE_STATION_RADIUS_KM=50

# Materials
MATERIALS_JSON_PATH=./data/materials.json
CUSTOM_MATERIALS_ENABLED=True

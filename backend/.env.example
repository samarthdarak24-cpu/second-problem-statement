# Copy to `.env` and edit. Every value has a working default, so an empty file
# is also valid — the service runs with no configuration at all.

# --- Service ---------------------------------------------------------------
APP_NAME=SIH Thermal Shelter API
VERSION=1.0.0
DEBUG=false

# --- Persistence -----------------------------------------------------------
# Defaults to SQLite so the service runs with no infrastructure. Point this at
# PostgreSQL for the deployment topology the architecture diagram claims; the
# repository layer is identical either way.
#
# DATABASE_URL=postgresql+psycopg://shelter:shelter@localhost:5432/shelter
DATABASE_URL=sqlite:///./thermal_shelter.db
SQL_ECHO=false

# --- CORS ------------------------------------------------------------------
# The dashboard runs on a different origin in development. Comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Climate provider ------------------------------------------------------
OPEN_METEO_BASE=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT_S=20.0
# The live archive is an upgrade over the offline catalogue, not a prerequisite.
# Four seconds is long enough for a slow link and short enough that a dead one
# costs a visible pause rather than a stall.
LIVE_PROBE_TIMEOUT_S=4.0
ENABLE_LIVE_CLIMATE=true

# --- ML surrogate ----------------------------------------------------------
MODEL_DIR=./models
# The accuracy gate is NOT configurable here on purpose — it is part of the model
# contract and lives beside FEATURE_NAMES in app/ml.py, mirroring ml/surrogate.ts.
# A deployer must not be able to relax it into usefulness.
MIN_TRAIN_ROWS=200
